---
import '../styles/global.css';
import { site, nav, faqs } from '../data/site';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description?: string;
  overlayHeader?: boolean;
  image?: string;
  faqSchema?: boolean;
}
const { title, description = site.description, overlayHeader = false, image = '/images/hero-huli-stadium.webp', faqSchema = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const path = Astro.url.pathname;
const fullTitle = title === site.name ? `${site.name} | Live Rugby League Trips to Papua New Guinea` : `${title} | ${site.name}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: site.name,
  description: site.description,
  url: site.url,
  email: site.email,
  telephone: '+61437933381',
  areaServed: 'Papua New Guinea',
  address: { '@type': 'PostalAddress', streetAddress: '2 Holden Close', addressLocality: 'Whitfield', addressRegion: 'QLD', postalCode: '4870', addressCountry: 'AU' },
  parentOrganization: { '@type': 'Organization', name: 'No Limit Adventures Pty Ltd', url: site.links.nla },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta name="theme-color" content="#1F1714">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={site.name}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={new URL(image, site.url).href}>
  <meta property="og:locale" content="en_AU">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,500..800&family=IBM+Plex+Mono:wght@400;500&family=Public+Sans:wght@400;500;600&display=swap">
  <link rel="sitemap" href="/sitemap-index.xml">
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class:list={['site-header', { overlay: overlayHeader }]}>
    <div class="wrap header-inner">
      <a class="brand" href="/" aria-label={`${site.name} home`}>
        <Logo />
        <span>PNG Rugby<br>League Tours</span>
      </a>
      <nav class="site-nav" id="site-nav" aria-label="Main">
        <button class="menu-close" type="button">Close ✕</button>
        <ul>
          {nav.map((n) => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}
        </ul>
        <a class="btn red" href="/enquire/">Register interest</a>
      </nav>
      <button class="menu-btn" type="button" aria-controls="site-nav" aria-expanded="false">Menu</button>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="top">
        <div>
          <a class="brand" href="/">
            <Logo />
            <span>PNG Rugby<br>League Tours</span>
          </a>
          <p>Live rugby league weekends and small-group adventures in Papua New Guinea, arranged end to end.</p>
        </div>
        <div>
          <h2>Talk to us</h2>
          {site.phones.map((p) => <a href={p.href}>{p.label}</a>)}
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <span>Cairns, Australia</span>
        </div>
        <div>
          <h2>Explore</h2>
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          <a href="/enquire/">Register interest</a>
        </div>
        <div>
          <h2>Sister brands</h2>
          <a href={site.links.surf}>PNG Surf Adventures</a>
          <a href={site.links.nla}>No Limit Adventures</a>
        </div>
      </div>
      <div class="legal">
        <p>PNG Rugby League Tours is a brand of No Limit Adventures Pty Ltd · ABN {site.abn} · Inbound Tour Operator #{site.ito} · Industry partner of the PNG Tourism Promotion Authority</p>
        <p>Independent tour operator. Not affiliated with, endorsed by or sponsored by any rugby league club, competition or governing body. Match tickets are not included in our packages.</p>
        <p>© {new Date().getFullYear()} <a href={site.links.nla}>No Limit Adventures</a> · <a href="/privacy/">Privacy</a></p>
      </div>
    </div>
  </footer>

  <script>
    const nav = document.getElementById('site-nav');
    const openBtn = document.querySelector<HTMLButtonElement>('.menu-btn');
    const closeBtn = nav?.querySelector<HTMLButtonElement>('.menu-close');
    const setOpen = (open: boolean) => {
      nav?.classList.toggle('open', open);
      openBtn?.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
      (open ? closeBtn : openBtn)?.focus();
    };
    openBtn?.addEventListener('click', () => setOpen(true));
    closeBtn?.addEventListener('click', () => setOpen(false));
    nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav?.classList.contains('open')) setOpen(false); });
  </script>
</body>
</html>
