---
import { faqs } from '../data/site';
interface Props { label?: string; heading?: string }
const { label = 'Good to know', heading = 'Rugby league in PNG: your questions' } = Astro.props;
---
<section class="sec" id="faq">
  <div class="wrap">
    <p class="label">{label}</p>
    <div class="body">
      <h2>{heading}</h2>
      <div>
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
