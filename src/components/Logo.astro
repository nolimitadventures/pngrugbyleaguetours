---
// Flag-inspired roundel: PNG diagonal (black lower-left, red upper-right), Southern Cross,
// and a gold rugby ball in place of the bird of paradise (the national emblem itself is not reproduced).
interface Props { size?: number; class?: string }
const { size = 40, class: cls } = Astro.props;
const uid = `lg${Math.random().toString(36).slice(2, 8)}`;

function star(cx: number, cy: number, r: number) {
  const pts: string[] = [];
  for (let i = 0; i < 10; i++) {
    const rad = i % 2 === 0 ? r : r * 0.42;
    const a = -Math.PI / 2 + (i * Math.PI) / 5;
    pts.push(`${(cx + rad * Math.cos(a)).toFixed(2)},${(cy + rad * Math.sin(a)).toFixed(2)}`);
  }
  return pts.join(' ');
}
const stars = [
  [11.5, 20.5, 2.3],
  [6.8, 25.8, 2.3],
  [16.2, 25.8, 2.3],
  [13.9, 29.2, 1.3],
  [11.5, 33, 2.3],
] as const;
---
<svg class={cls} width={size} height={size} viewBox="0 0 40 40" role="img" aria-label="PNG Rugby League Tours">
  <defs><clipPath id={uid}><circle cx="20" cy="20" r="19"/></clipPath></defs>
  <g clip-path={`url(#${uid})`}>
    <rect width="40" height="40" fill="#C42B23"/>
    <path d="M0 0 L40 40 L0 40 Z" fill="#121010"/>
    {stars.map(([x, y, r]) => <polygon points={star(x, y, r)} fill="#FFFFFF"/>)}
    <g transform="rotate(-35 27 13)">
      <ellipse cx="27" cy="13" rx="7.6" ry="4.6" fill="#F2B51D"/>
      <path d="M22.4 13 H31.6" stroke="#C42B23" stroke-width="1"/>
      <path d="M25 11.6v2.8M27 11.6v2.8M29 11.6v2.8" stroke="#C42B23" stroke-width=".9"/>
    </g>
  </g>
  <circle cx="20" cy="20" r="19" fill="none" stroke="#F2B51D" stroke-width="1.4"/>
</svg>
