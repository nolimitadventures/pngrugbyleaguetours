---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base title="How it works" description="From founding supporters list to match day in Port Moresby: how a PNG rugby league trip with us comes together." faqSchema>
  <section class="sec dark page-head">
    <div class="wrap">
      <p class="label">How it works</p>
      <div class="body">
        <h1>From the waitlist to the stands</h1>
        <p class="lede muted">You tell us who’s coming and what kind of trip you want. We handle the rest, and stay with you until you’re home.</p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <p class="label">The process</p>
      <div class="body">
        <ol class="steps">
          <li><h3>Join the list</h3><p>Leave your details now. There’s no cost and no obligation.</p></li>
          <li><h3>The draw is released</h3><p>Once the 2028 draw is confirmed, founding supporters get the match weekends and package details first.</p></li>
          <li><h3>Your proposal</h3><p>We send a clear itinerary with flights, hotel, transfers, tours and any extensions, fully priced.</p></li>
          <li><h3>We lock it in</h3><p>On your go-ahead we book everything and send a pre-departure pack covering visas, health and what to pack, plus how to buy match tickets.</p></li>
          <li><h3>Match weekend</h3><p>Your local host meets you at the airport. If a domestic flight moves, we re-route you. One contact, reachable throughout.</p></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <p class="label">Who we work with</p>
      <div class="body">
        <h2>Small groups only</h2>
        <p class="lede">Individuals, couples, groups of mates, supporter clubs, and corporate or special-interest groups. Every trip is private or small-group. We don’t do mass departures.</p>
      </div>
    </div>
  </section>

  <Faq />
  <CtaBand />
</Base>
