---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base title="Groups & corporate" description="Private rugby league weekends in Papua New Guinea for corporate teams, client trips, groups of mates and supporter clubs. 4–24 guests, one point of contact, one invoice." image="/images/goroka-show-guest.webp">
  <section class="sec dark page-head with-photo">
    <div class="wrap">
      <p class="label">Groups &amp; corporate</p>
      <div class="body">
        <h1>A trip your team will still be talking about next year</h1>
        <p class="lede muted">Private match weekends in Port Moresby for 4 to 24 guests, with a reef, river or Highlands finish. One planner, one invoice, and someone on the ground the whole way.</p>
      </div>
    </div>
  </section>
  <figure class="page-photo">
    <img src="/images/goroka-show-guest.webp" alt="A smiling traveller with a painted Highlands performer at the Goroka Show" width="1115" height="742" fetchpriority="high" style="object-position:50% 35%">
    <figcaption>Goroka Show · Eastern Highlands</figcaption>
  </figure>

  <section class="sec">
    <div class="wrap">
      <p class="label">Who it’s for</p>
      <div class="body">
        <h2>Built around your group</h2>
        <div class="rows">
          <div><h3>Staff incentive trips</h3><p>A reward that stands out. Footy weekend in the capital, then diving or fishing to finish. Easy to sell internally.</p></div>
          <div><h3>Client trips</h3><p>Take your best clients somewhere they’ve never been. Private dinners, cultural experiences and a hosted weekend around the match.</p></div>
          <div><h3>Business in PNG</h3><p>Already working in Papua New Guinea? We’ll fit the trip around meetings and site visits in Port Moresby.</p></div>
          <div><h3>Groups of mates</h3><p>Bucks, milestone birthdays or just a long-promised footy trip, planned properly and safely.</p></div>
          <div><h3>Supporter clubs</h3><p>Bring your club to PNG with flights, accommodation and transfers in one booking.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <p class="label">On the ground</p>
      <div class="body">
        <h2>What your group gets</h2>
        <ul class="ticks">
          <li>A dedicated tour manager from first call to flight home</li>
          <li>Private vehicles and drivers we know, including match-day transport</li>
          <li>Secure, quality hotels in Port Moresby</li>
          <li>Private group dinners and welcome functions</li>
          <li>Cultural performances, market and village visits</li>
          <li>Group rates on dive, fishing, Kokoda and Highlands extensions</li>
          <li>One invoice and a single point of contact</li>
        </ul>
        <p class="muted" style="font-size:.95rem">Match tickets aren’t included in our packages. We’ll let you know when tickets go on sale and how to buy them for your group.</p>
      </div>
    </div>
  </section>

  <CtaBand heading="Tell us about your group" text="Rough numbers and a preferred month are enough to start. We’ll come back within one business day with ideas and timings." />
</Base>
