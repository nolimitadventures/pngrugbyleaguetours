---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="sec dark page-head">
    <div class="wrap">
      <p class="label">404</p>
      <div class="body">
        <h1>Knocked on. That page isn’t here.</h1>
        <p class="lede muted">The page may have moved. Head back to the home page or get in touch.</p>
        <div><a class="btn light" href="/">Back to home</a></div>
      </div>
    </div>
  </section>
</Base>
