---
import Base from '../layouts/Base.astro';
---
<Base title="Thanks" description="Thanks for joining the founding supporters list.">
  <section class="sec dark page-head">
    <div class="wrap">
      <p class="label">You’re on the list</p>
      <div class="body">
        <h1>Thanks. We’ll be in touch.</h1>
        <p class="lede muted">We reply within one business day. You’ll also hear from us as soon as the 2028 draw and match weekends are confirmed.</p>
        <div><a class="btn light" href="/extend-your-trip/">Explore extensions while you wait</a></div>
      </div>
    </div>
  </section>
</Base>
